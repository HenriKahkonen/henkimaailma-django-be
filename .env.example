
DJANGO_SECRET_KEY=a_generated_secure_key
DB_SSL_REQUIRE=False
DATABASE_URL=your_connection_string, if you want to pass a connection string to an external db
DEBUG_MODE=True
ALLOWED_HOSTS=localhost
CORS_ALLOWED_ORIGINS =https:/allowed_origin_1.com,https:/allowed_origin_2.com
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://your.api.address.com

DB_HOST=db_hostname, or delete line if you want to default to localhost
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PORT=5432
DB_PASSWORD=your_password

